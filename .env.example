# SubliManager V1 — variables de entorno (copiar a .env)
# No commitear secretos reales.

# Aplicación
APP_NAME=SubliManager
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL (Psycopg 3 / SQLAlchemy)
# Formato: postgresql+psycopg://usuario:clave@host:puerto/nombre_bd
DATABASE_URL=postgresql+psycopg://sublimanager:sublimanager@localhost:5432/sublimanager

# Tests de integración (opcional). Si no está definido, los tests de DB se omiten.
# TEST_DATABASE_URL=postgresql+psycopg://sublimanager:sublimanager@localhost:5432/sublimanager_test

# Ruta raíz para archivos de diseño (Stage 5+)
DESIGNS_ROOT=./data/disenos
